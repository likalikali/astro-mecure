---
import PageLayout from '@/layouts/PageLayout.astro';
import type { Page } from '@/types';
import { url } from '@/utils/url';

const page: Page = {
  title: '404',
  description: '这只大福还没找到你要的页面。',
};
---

<PageLayout page={page} hasSidebar={false} hasHero={false}>
  <div class="flex min-h-[65vh] items-center justify-center px-4 py-12">
    <section class="mx-auto max-w-lg text-center">
      <img src={url('favicon.svg')} alt="一只戴樱花的可爱白色大福" width="128" height="128" class="mx-auto drop-shadow-xl" />
      <h1 class="mt-6 text-5xl font-bold text-gray-800 dark:text-gray-100">404</h1>
      <p class="mt-3 text-xl text-gray-700 dark:text-gray-300">页面跑去赏樱花啦</p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">你访问的页面可能不存在，或者已经搬家了。</p>
      <a href={url('/')} class="mt-6 inline-block rounded-xl bg-primary-600 px-5 py-3 text-sm font-medium text-white shadow-md transition hover:bg-primary-700">返回首页</a>
    </section>
  </div>
</PageLayout>
