---
import PageLayout from '@/layouts/PageLayout.astro';
import type { Page } from '@/types';
import Friend from '@/components/Friend';
import { getCollection } from 'astro:content';
import { FRIENDS_COLLECTION_NAME } from '@/constants';

const page: Page = {
  title: '友情链接',
  description: '在樱花树下，遇见有趣的人。',
};
const friendEntries = await getCollection(FRIENDS_COLLECTION_NAME);
---

<PageLayout page={page} hasFooter={true} hasHero={true} hasNavbar={true} hasComment={false} hasSidebar={false}>
  <section class="mb-6 not-prose">
    <h2 class="mb-3 text-xl font-bold">友人帐</h2>
    {friendEntries.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {friendEntries.map(entry => <Friend {...entry.data} />)}
      </div>
    ) : (
      <p class="rounded-xl border border-gray-200 bg-white/70 p-6 text-gray-600 dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-300">
        友人帐还空着。如果你也喜欢分享技术与生活，欢迎来交换友链。
      </p>
    )}
  </section>
  <section class="prose dark:prose-invert dark:prose-dark plate-bg border-highlight rounded-xl p-4 md:p-8">
    <h2>申请友链</h2>
    <p>欢迎通过 <a href="mailto:likafeaturingnino@163.com">邮件联系</a>，提供站点名称、网址、简介和头像链接。</p>
    <p>也可以向 <a href="https://github.com/likalikali/astro-mecure/pulls" target="_blank" rel="noopener noreferrer">本站 GitHub 仓库</a> 提交 Pull Request，在 <code>src/content/friends/</code> 中添加自己的 <code>your-name.json</code>。</p>
  </section>
</PageLayout>
