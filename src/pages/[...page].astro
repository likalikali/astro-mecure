---
import type { GetStaticPaths, Page as AstroPage } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard';
import getPosts from '@/utils/getPosts';
import { compareDesc } from 'date-fns';
import type { Page, Post } from '@/types';
import { createPaginator } from '@/utils/createPaginator';
import config from '@/config';

export interface Props {
  page: AstroPage<Omit<Post, 'Content'>>;
}

const pageParam = Astro.params.page;
if(pageParam && !/^page\/[1-9]\d*$/.test(pageParam)) return new Response('页面不存在',{status:404});
const current = pageParam ? Number(pageParam.split('/')[1]) : 1;
const allPosts = (await getPosts()).sort((a,b) => compareDesc(a.date,b.date));
const pageSize = config.pagination === false ? Math.max(1,allPosts.length) : config.pagination?.pageSize || 10;
const lastPage = Math.max(1,Math.ceil(allPosts.length/pageSize));
if(current > lastPage) return new Response('页面不存在',{status:404});
const data = allPosts.slice((current-1)*pageSize,current*pageSize);
const page = { data, total: allPosts.length, currentPage: current, lastPage, size: data.length } as AstroPage<Omit<Post,'Content'>>;

const pageConfig: Page = {
  type: 'index',
  title: config.title,
  description: config.description,
  posts: page.data,
  ...(page.total > 0
    ? { paginator: createPaginator(page, { includesFirstPageNumber: true }) }
    : {})
}
---

<PageLayout page={pageConfig}>
  <div class='flex flex-col gap-y-4 md:gap-y-6'>
    {page.data.length === 0 && (
      <section class="plate-bg border-highlight rounded-2xl p-8 text-center md:p-12">
        <img src={config.favicon} width="88" height="88" class="mx-auto mb-5" alt="白色糯米团子" />
        <h2 class="mb-3 text-xl font-semibold">欢迎来到 团子 的记事簿</h2>
        <p class="text-sm leading-7 text-gray-600 dark:text-gray-300">
          这里正在整理文章。新的记录会陆续出现在这里。
        </p>
      </section>
    )}
    {
      page.data.map((post, index) => {
        return <PostCard
          title={post.title} 
          excerpt={post.excerpt}
          image={post.image}
          date={post.date}
          url={post.url}
          wordCount={post.wordCount}
          readingTime={post.readingTime && Math.ceil(post.readingTime)}
          tags={post.tags}
          category={post.category}
          variant={post.cardVariant}
          imagePosition={index%2==0?'left':'right'}
        ></PostCard>
      })
    }
  </div>
</PageLayout>
