---
import type { GetStaticPaths, Page as AstroPage } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard';
import getPosts from '@/utils/getPosts';
import { compareDesc } from 'date-fns';
import type { Page, Post } from '@/types';
import { createPaginator } from '@/utils/createPaginator';
import config from '@/config';

export interface Props {
  page: AstroPage<Omit<Post, 'Content'>>;
}

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getPosts()).filter(post => !post.draft).sort((a, b) => compareDesc(a.date, b.date));
  // Keep / available even when every inherited article is an unpublished draft.
  if (allPosts.length === 0) {
    return [{
      params: { page: undefined },
      props: {
        page: {
          data: [],
          start: 0,
          end: 0,
          size: 0,
          total: 0,
          currentPage: 1,
          lastPage: 1,
          url: {
            current: '/',
            first: undefined,
            last: undefined,
            next: undefined,
            prev: undefined,
          },
        } as AstroPage<Omit<Post, 'Content'>>,
      },
    }];
  }

  return paginate(allPosts, {
    pageSize: config.pagination === false ? Infinity : config.pagination?.pageSize,
  }).map(item => ({
    params: {
      // page is undefined for the first page when using rest parameter in filename
      page: item.params.page ? `page/${item.params.page}` : undefined
    },
    props: item.props,
  }));
}) satisfies GetStaticPaths;

const { page }= Astro.props;

const pageConfig: Page = {
  type: 'index',
  title: config.title,
  description: config.description,
  posts: page.data,
  ...(page.total > 0
    ? { paginator: createPaginator(page, { includesFirstPageNumber: true }) }
    : {})
}
---

<PageLayout page={pageConfig}>
  <div class='flex flex-col gap-y-4 md:gap-y-6'>
    {page.data.length === 0 && (
      <section class="plate-bg border-highlight rounded-2xl p-8 text-center md:p-12">
        <img src={config.favicon} width="88" height="88" class="mx-auto mb-5" alt="白色糯米团子" />
        <h2 class="mb-3 text-xl font-semibold">欢迎来到 团子 的记事簿</h2>
        <p class="text-sm leading-7 text-gray-600 dark:text-gray-300">
          这里正在整理文章。新的记录会陆续出现在这里。
        </p>
      </section>
    )}
    {
      page.data.map((post, index) => {
        return <PostCard
          title={post.title} 
          excerpt={post.excerpt}
          image={post.image}
          date={post.date}
          url={post.url}
          wordCount={post.wordCount}
          readingTime={post.readingTime && Math.ceil(post.readingTime)}
          tags={post.tags}
          category={post.category}
          variant={post.cardVariant}
          imagePosition={index%2==0?'left':'right'}
        ></PostCard>
      })
    }
  </div>
</PageLayout>
